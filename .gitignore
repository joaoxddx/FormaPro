# ==========================================
# Root .gitignore - FormaPRO Monorepo
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Production & Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/

# Environment Variables & Secrets (CRITICAL: Never push secrets to GitHub)
.env
*/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor configurations
.idea/
*/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tests & Coverage
coverage/
*/coverage/
.nyc_output/

# Prisma generated clients / skills
generated/
skills/

# Temp files
.tmp/
.temp/
*.pid
*.seed
